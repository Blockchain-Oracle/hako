{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../../packages/config/src/**/*.ts",
    "../../packages/networks/src/**/*.ts",
    "../../packages/money/src/**/*.ts",
    "../../packages/defi/src/core/**/*.ts"
  ]
}
