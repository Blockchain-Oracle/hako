{
  "$id": "https://usehako.xyz/schemas/cards/catalog.json",
  "title": "catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "providerName": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "render": {
            "type": "string"
          },
          "price": {
            "type": "object",
            "properties": {
              "usd": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              "atomic": {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Atomic units, e.g. 1000000 = 1 USDC"
              },
              "tier": {
                "type": "string",
                "minLength": 1
              },
              "network": {
                "type": "string",
                "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
                "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
              }
            },
            "required": [
              "usd",
              "atomic",
              "tier",
              "network"
            ],
            "additionalProperties": false
          },
          "method": {
            "type": "string",
            "const": "POST"
          },
          "path": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "score": {
            "type": "number"
          },
          "health": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "healthy",
                  "stable",
                  "degraded",
                  "outage",
                  "unknown"
                ]
              },
              "runs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "successRate": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p50Ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p95Ms": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lastOkAt": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "status",
              "runs",
              "successRate",
              "p50Ms",
              "p95Ms"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "id",
          "provider",
          "providerName",
          "slug",
          "displayName",
          "summary",
          "categories",
          "render",
          "price",
          "method",
          "path",
          "available",
          "score",
          "health"
        ],
        "additionalProperties": {}
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "query",
    "count",
    "candidates",
    "hints"
  ],
  "additionalProperties": {}
}
