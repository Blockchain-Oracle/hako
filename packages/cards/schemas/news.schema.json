{
  "$id": "https://usehako.xyz/schemas/cards/news.schema.json",
  "title": "news",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "publisher_url": {
            "type": "string"
          },
          "published": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "seen_at": {
            "type": "string"
          },
          "points": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "also_in": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "image_url": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": {}
      }
    },
    "query": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "articles"
  ],
  "additionalProperties": {}
}
