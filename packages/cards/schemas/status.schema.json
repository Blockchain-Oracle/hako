{
  "$id": "https://usehako.xyz/schemas/cards/status.schema.json",
  "title": "status",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draftId": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "send",
            "swap",
            "bridge",
            "earn_deposit",
            "earn_withdraw",
            "run",
            "invoice_pay"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "submitted",
            "working",
            "input_required",
            "auth_required",
            "ready_for_approval",
            "approved",
            "executing",
            "completed",
            "failed",
            "rejected",
            "canceled",
            "expired",
            "unknown_outcome"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "requestStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pending_approval",
            "pending_funding",
            "pending_signature",
            "pending_settlement",
            "pending_confirmation",
            "success",
            "denied",
            "error"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "waitsOn": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "approval",
            "funding",
            "signature",
            "settlement",
            "confirmation"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "stage": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "approval",
            "funding",
            "signing",
            "sending",
            "sent",
            "arriving",
            "confirmed",
            "reverted",
            "refused"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "approvalUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "signUrl": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "txs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
            "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,90}$"
              }
            ]
          },
          "explorerUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "approve",
              "source",
              "destination",
              "payment",
              "deposit",
              "withdraw",
              "transfer"
            ]
          }
        },
        "required": [
          "chain",
          "hash",
          "explorerUrl",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reused": {
      "type": "boolean"
    },
    "receiptId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "draftId",
    "version",
    "kind",
    "state",
    "requestId",
    "requestStatus",
    "waitsOn",
    "stage",
    "approvalUrl",
    "signUrl",
    "txs",
    "reason",
    "reused",
    "receiptId",
    "updatedAt"
  ],
  "additionalProperties": false
}
