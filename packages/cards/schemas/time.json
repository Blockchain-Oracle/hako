{
  "$id": "https://usehako.xyz/schemas/cards/time.json",
  "title": "time",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "zone": {
          "type": "string"
        },
        "local_time": {
          "type": "string"
        },
        "utc_offset": {
          "type": "string"
        },
        "at_utc": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string"
        },
        "is_dst": {
          "type": "boolean"
        },
        "conversions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "zone": {
                "type": "string"
              },
              "local_time": {
                "type": "string"
              },
              "utc_offset": {
                "type": "string"
              }
            },
            "required": [
              "zone",
              "local_time",
              "utc_offset"
            ],
            "additionalProperties": {}
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "zone",
        "local_time",
        "utc_offset"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "calendar": {
          "type": "string"
        },
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "business_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "weekend": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "holidays_skipped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "calendar",
        "start",
        "end",
        "business_days"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "country": {
          "type": "string"
        },
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "other_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "observed": {
                "type": "boolean"
              }
            },
            "required": [
              "date",
              "name"
            ],
            "additionalProperties": {}
          }
        },
        "calendar": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "country",
        "year",
        "holidays"
      ],
      "additionalProperties": {}
    }
  ]
}
