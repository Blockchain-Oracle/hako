{
  "$id": "https://usehako.xyz/schemas/cards/audio.schema.json",
  "title": "audio",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "file_id": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "speech",
        "sound_effect",
        "music"
      ]
    },
    "expires_at": {
      "type": "string"
    },
    "duration_s": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "voice": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "file_id",
    "url",
    "mime_type",
    "kind",
    "expires_at"
  ],
  "additionalProperties": {}
}
