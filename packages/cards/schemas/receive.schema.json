{
  "$id": "https://usehako.site/schemas/cards/receive.schema.json",
  "title": "receive",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "object",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "evm",
            "solana"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "family"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "token": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "chain": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
              "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
            },
            "address": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "name": {
              "type": "string"
            },
            "logoUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "chain",
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "qrPayload": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "wallet",
    "chain",
    "token",
    "qrPayload"
  ],
  "additionalProperties": false
}
