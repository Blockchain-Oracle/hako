{
  "$id": "https://usehako.xyz/schemas/cards/swap_draft.schema.json",
  "title": "swap_draft",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input_required",
        "auth_required",
        "ready_for_approval",
        "approved",
        "executing",
        "completed",
        "failed",
        "rejected",
        "canceled",
        "expired",
        "unknown_outcome"
      ]
    },
    "quote": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tool": {
              "type": [
                "string",
                "null"
              ]
            },
            "fromAmountAtomic": {
              "type": "string",
              "pattern": "^\\d+$",
              "description": "Atomic units, e.g. 1000000 = 1 USDC"
            },
            "toAmountAtomic": {
              "type": "string",
              "pattern": "^\\d+$",
              "description": "Atomic units, e.g. 1000000 = 1 USDC"
            },
            "toAmountMinAtomic": {
              "type": "string",
              "pattern": "^\\d+$",
              "description": "Atomic units, e.g. 1000000 = 1 USDC"
            },
            "feeUsd": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^-?\\d+(\\.\\d+)?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "estimatedDurationS": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "approvalAddress": {
              "type": [
                "string",
                "null"
              ]
            },
            "quotedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "tool",
            "fromAmountAtomic",
            "toAmountAtomic",
            "toAmountMinAtomic",
            "feeUsd",
            "estimatedDurationS",
            "approvalAddress",
            "quotedAt",
            "expiresAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "rehearsal": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "skipped",
                "unsupported"
              ]
            },
            "key": {
              "type": "string",
              "pattern": "^[\\s\\S]{0,}:-?\\d+(?:\\.\\d+)?$"
            },
            "chain": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
              "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
            },
            "reason": {
              "type": "string"
            },
            "simulatedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            }
          },
          "required": [
            "status",
            "key",
            "chain"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "fromChain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "toChain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "amount": {
      "type": "object",
      "properties": {
        "token": {
          "type": "object",
          "properties": {
            "chain": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
              "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
            },
            "address": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "name": {
              "type": "string"
            },
            "logoUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "chain",
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "amountAtomic": {
          "type": "string",
          "pattern": "^\\d+$",
          "description": "Atomic units, e.g. 1000000 = 1 USDC"
        },
        "usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "token",
        "amountAtomic",
        "usd"
      ],
      "additionalProperties": false
    },
    "toToken": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
          "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "chain",
        "address",
        "symbol",
        "decimals"
      ],
      "additionalProperties": false
    },
    "from": {
      "type": "object",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "evm",
            "solana"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "family"
      ],
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "evm",
            "solana"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "family"
      ],
      "additionalProperties": false
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "draftId",
    "version",
    "state",
    "quote",
    "rehearsal",
    "createdAt",
    "updatedAt",
    "fromChain",
    "toChain",
    "amount",
    "toToken",
    "from",
    "to",
    "tool"
  ],
  "additionalProperties": false
}
