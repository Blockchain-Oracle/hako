{
  "$id": "https://usehako.site/schemas/cards/balance.schema.json",
  "title": "balance",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "address": {
      "type": "string"
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "decimals": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "amount_atomic": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Atomic units, e.g. 1000000 = 1 USDC"
          },
          "amount": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "usd": {
            "type": "number"
          }
        },
        "required": [
          "symbol",
          "address",
          "decimals",
          "amount_atomic",
          "amount"
        ],
        "additionalProperties": {}
      }
    },
    "block_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "chain",
    "address",
    "balances"
  ],
  "additionalProperties": {}
}
