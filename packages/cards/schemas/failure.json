{
  "$id": "https://usehako.xyz/schemas/cards/failure.json",
  "title": "failure",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "moneyMoved": {
      "type": "string",
      "enum": [
        "no",
        "yes",
        "unknown"
      ]
    },
    "requestId": {
      "type": [
        "string",
        "null"
      ]
    },
    "txs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "chain": {
            "type": "string",
            "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
            "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
          },
          "hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{64,90}$"
              }
            ]
          },
          "explorerUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "approve",
              "source",
              "destination",
              "payment",
              "deposit",
              "withdraw",
              "transfer"
            ]
          }
        },
        "required": [
          "chain",
          "hash",
          "explorerUrl",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "fix": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "fix": {
              "type": "string",
              "enum": [
                "connect_paybox",
                "reconnect_paybox",
                "add_money",
                "raise_limit",
                "top_up_gas",
                "retry",
                "fresh_quote"
              ]
            },
            "action": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "link"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "url"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "tool"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "tool": {
                      "type": "string",
                      "minLength": 1
                    },
                    "input": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "tool",
                    "input"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "prompt"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 280
                    }
                  },
                  "required": [
                    "type",
                    "label",
                    "prompt"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "fix",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "technical": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "title",
    "reason",
    "moneyMoved",
    "requestId",
    "txs",
    "fix",
    "technical"
  ],
  "additionalProperties": false
}
