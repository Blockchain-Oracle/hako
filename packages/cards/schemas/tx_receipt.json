{
  "$id": "https://usehako.xyz/schemas/cards/tx_receipt.json",
  "title": "tx_receipt",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "hash": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "reverted",
        "pending",
        "not_found"
      ]
    },
    "block_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "value_atomic": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "gas_used": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "fee_atomic": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "timestamp": {
      "type": "string"
    },
    "confirmations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "explorer_url": {
      "type": "string"
    },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "amount_atomic": {
            "type": "string",
            "pattern": "^\\d+$",
            "description": "Atomic units, e.g. 1000000 = 1 USDC"
          },
          "symbol": {
            "type": "string"
          },
          "decimals": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "token",
          "from",
          "to",
          "amount_atomic"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "chain",
    "hash",
    "status"
  ],
  "additionalProperties": {}
}
