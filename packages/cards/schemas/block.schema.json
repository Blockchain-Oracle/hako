{
  "$id": "https://usehako.xyz/schemas/cards/block.schema.json",
  "title": "block",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "tx_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gas_used": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "gas_limit": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "base_fee_gwei": {
      "type": "number"
    },
    "miner": {
      "type": "string"
    },
    "explorer_url": {
      "type": "string"
    }
  },
  "required": [
    "chain",
    "number",
    "hash",
    "timestamp",
    "tx_count"
  ],
  "additionalProperties": {}
}
