{
  "$id": "https://usehako.xyz/schemas/cards/contract_read.json",
  "title": "contract_read",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "address": {
      "type": "string"
    },
    "function": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {}
    },
    "result": {},
    "block_number": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "chain",
    "address",
    "function",
    "args",
    "result"
  ],
  "additionalProperties": {}
}
