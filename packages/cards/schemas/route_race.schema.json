{
  "$id": "https://usehako.xyz/schemas/cards/route_race.schema.json",
  "title": "route_race",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "raceId": {
      "type": "string",
      "minLength": 1
    },
    "fromChain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "toChain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "fromToken": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
          "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "chain",
        "address",
        "symbol",
        "decimals"
      ],
      "additionalProperties": false
    },
    "toToken": {
      "type": "object",
      "properties": {
        "chain": {
          "type": "string",
          "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
          "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
        },
        "address": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string"
        },
        "logoUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "chain",
        "address",
        "symbol",
        "decimals"
      ],
      "additionalProperties": false
    },
    "fromAmountAtomic": {
      "type": "string",
      "pattern": "^\\d+$",
      "description": "Atomic units, e.g. 1000000 = 1 USDC"
    },
    "asked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "answered": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12
    },
    "done": {
      "type": "boolean"
    },
    "rows": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string",
            "minLength": 1
          },
          "toolName": {
            "type": "string",
            "minLength": 1
          },
          "logoUrl": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "asking",
              "answered",
              "failed",
              "timed_out"
            ]
          },
          "toAmountAtomic": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Atomic units, e.g. 1000000 = 1 USDC"
              },
              {
                "type": "null"
              }
            ]
          },
          "toAmountMinAtomic": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+$",
                "description": "Atomic units, e.g. 1000000 = 1 USDC"
              },
              {
                "type": "null"
              }
            ]
          },
          "feeUsd": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "estimatedDurationS": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "tool",
          "toolName",
          "logoUrl",
          "status",
          "toAmountAtomic",
          "toAmountMinAtomic",
          "feeUsd",
          "estimatedDurationS",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "winner": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "raceId",
    "fromChain",
    "toChain",
    "fromToken",
    "toToken",
    "fromAmountAtomic",
    "asked",
    "answered",
    "done",
    "rows",
    "winner"
  ],
  "additionalProperties": false
}
