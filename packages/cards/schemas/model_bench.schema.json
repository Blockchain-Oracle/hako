{
  "$id": "https://usehako.xyz/schemas/cards/model_bench.schema.json",
  "title": "model_bench",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "intelligence_index": {
            "type": "number"
          },
          "output_tokens_per_s": {
            "type": "number"
          },
          "first_token_s": {
            "type": "number"
          },
          "price_input_per_m_usd": {
            "type": "number"
          },
          "price_output_per_m_usd": {
            "type": "number"
          },
          "elo": {
            "type": "number"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": {}
      }
    },
    "metric": {
      "type": "string"
    }
  },
  "required": [
    "category",
    "models"
  ],
  "additionalProperties": {}
}
