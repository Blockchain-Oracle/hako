{
  "$id": "https://usehako.site/schemas/cards/logs.schema.json",
  "title": "logs",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "logs": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "block_number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tx_hash": {
            "type": "string"
          },
          "log_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "address": {
            "type": "string"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "data": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "args": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "block_number",
          "tx_hash",
          "log_index",
          "address",
          "topics",
          "data"
        ],
        "additionalProperties": {}
      }
    },
    "address": {
      "type": "string"
    },
    "from_block": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "to_block": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "chain",
    "logs"
  ],
  "additionalProperties": {}
}
