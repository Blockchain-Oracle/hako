{
  "$id": "https://usehako.xyz/schemas/cards/chain_name.schema.json",
  "title": "chain_name",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "name": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "enum": [
        "ens",
        "basename"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "avatar_url": {
      "type": "string"
    }
  },
  "required": [
    "chain",
    "name",
    "address",
    "service",
    "direction"
  ],
  "additionalProperties": {}
}
