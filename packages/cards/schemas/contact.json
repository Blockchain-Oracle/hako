{
  "$id": "https://usehako.xyz/schemas/cards/contact.json",
  "title": "contact",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              }
            ]
          },
          "family": {
            "type": "string",
            "enum": [
              "evm",
              "solana"
            ]
          },
          "payboxUsername": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ]
          },
          "verified": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "family",
          "payboxUsername",
          "verified",
          "createdAt"
        ],
        "additionalProperties": false
      }
    },
    "action": {
      "type": "string",
      "enum": [
        "list",
        "added",
        "renamed",
        "deleted",
        "resolved"
      ]
    },
    "changedId": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "contacts",
    "action",
    "changedId"
  ],
  "additionalProperties": false
}
