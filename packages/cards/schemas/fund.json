{
  "$id": "https://usehako.xyz/schemas/cards/fund.json",
  "title": "fund",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallet": {
      "type": "object",
      "properties": {
        "address": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          ]
        },
        "family": {
          "type": "string",
          "enum": [
            "evm",
            "solana"
          ]
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "address",
        "family"
      ],
      "additionalProperties": false
    },
    "chain": {
      "type": "string",
      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
    },
    "buy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "currencyCode": {
              "type": "string",
              "minLength": 1
            },
            "network": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
              "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
            }
          },
          "required": [
            "url",
            "currencyCode",
            "network"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "deposit": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "expiresAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "amountUsd": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "required": [
            "url",
            "expiresAt",
            "amountUsd"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "qrPayload": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "wallet",
    "chain",
    "buy",
    "deposit",
    "qrPayload"
  ],
  "additionalProperties": false
}
