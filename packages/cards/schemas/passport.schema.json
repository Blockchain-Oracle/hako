{
  "$id": "https://usehako.site/schemas/cards/passport.schema.json",
  "title": "passport",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wallets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "credentialId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "family": {
            "type": "string",
            "enum": [
              "evm",
              "solana"
            ]
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              {
                "type": "string",
                "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
              }
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "always_approve",
              "iframe",
              "autonomous",
              "paybox"
            ]
          },
          "balances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "token": {
                  "type": "object",
                  "properties": {
                    "chain": {
                      "type": "string",
                      "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
                      "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
                    },
                    "address": {
                      "type": "string",
                      "minLength": 1
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1
                    },
                    "decimals": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "name": {
                      "type": "string"
                    },
                    "logoUrl": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "chain",
                    "address",
                    "symbol",
                    "decimals"
                  ],
                  "additionalProperties": false
                },
                "amountAtomic": {
                  "type": "string",
                  "pattern": "^\\d+$",
                  "description": "Atomic units, e.g. 1000000 = 1 USDC"
                },
                "usd": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^-?\\d+(\\.\\d+)?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "token",
                "amountAtomic",
                "usd"
              ],
              "additionalProperties": false
            }
          },
          "gasReady": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "fix": {
                  "type": "string",
                  "enum": [
                    "connect_paybox",
                    "reconnect_paybox",
                    "add_money",
                    "raise_limit",
                    "top_up_gas",
                    "retry",
                    "fresh_quote",
                    "change_network"
                  ]
                },
                "action": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "link"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "type",
                        "label",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "tool"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "tool": {
                          "type": "string",
                          "minLength": 1
                        },
                        "input": {
                          "type": "object",
                          "propertyNames": {
                            "type": "string"
                          },
                          "additionalProperties": {}
                        }
                      },
                      "required": [
                        "type",
                        "label",
                        "tool",
                        "input"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "prompt"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40
                        },
                        "prompt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 280
                        }
                      },
                      "required": [
                        "type",
                        "label",
                        "prompt"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "text",
                "fix",
                "action"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "credentialId",
          "name",
          "family",
          "address",
          "mode",
          "balances",
          "gasReady",
          "issues"
        ],
        "additionalProperties": false
      }
    },
    "ungranted": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "card",
              "wallet",
              "secret"
            ]
          },
          "family": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "evm",
                  "solana"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "kind",
          "family",
          "count"
        ],
        "additionalProperties": false
      }
    },
    "agentSignerRecorded": {
      "type": "boolean"
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "official",
              "unofficial"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "enabled"
        ],
        "additionalProperties": false
      }
    },
    "hakoEnabled": {
      "type": "boolean"
    },
    "canDo": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "fix": {
            "type": "string",
            "enum": [
              "connect_paybox",
              "reconnect_paybox",
              "add_money",
              "raise_limit",
              "top_up_gas",
              "retry",
              "fresh_quote",
              "change_network"
            ]
          },
          "action": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "link"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "url": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "type",
                  "label",
                  "url"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "tool"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1
                  },
                  "input": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  }
                },
                "required": [
                  "type",
                  "label",
                  "tool",
                  "input"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "prompt"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 280
                  }
                },
                "required": [
                  "type",
                  "label",
                  "prompt"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "text",
          "fix",
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "wallets",
    "ungranted",
    "agentSignerRecorded",
    "plugins",
    "hakoEnabled",
    "canDo",
    "issues"
  ],
  "additionalProperties": false
}
