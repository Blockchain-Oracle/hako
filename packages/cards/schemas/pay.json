{
  "$id": "https://usehako.xyz/schemas/cards/pay.json",
  "title": "pay",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draftId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "type": "string",
      "enum": [
        "submitted",
        "working",
        "input_required",
        "auth_required",
        "ready_for_approval",
        "approved",
        "executing",
        "completed",
        "failed",
        "rejected",
        "canceled",
        "expired",
        "unknown_outcome"
      ]
    },
    "tool": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "providerName": {
          "type": "string",
          "minLength": 1
        },
        "render": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "displayName",
        "provider",
        "providerName",
        "render",
        "summary"
      ],
      "additionalProperties": false
    },
    "price": {
      "type": "object",
      "properties": {
        "token": {
          "type": "object",
          "properties": {
            "chain": {
              "type": "string",
              "pattern": "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,64}$",
              "description": "CAIP-2 chain id, e.g. eip155:8453 (Base) or solana:mainnet"
            },
            "address": {
              "type": "string",
              "minLength": 1
            },
            "symbol": {
              "type": "string",
              "minLength": 1
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "name": {
              "type": "string"
            },
            "logoUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "chain",
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "amountAtomic": {
          "type": "string",
          "pattern": "^\\d+$",
          "description": "Atomic units, e.g. 1000000 = 1 USDC"
        },
        "usd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?\\d+(\\.\\d+)?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "token",
        "amountAtomic",
        "usd"
      ],
      "additionalProperties": false
    },
    "paidUrl": {
      "type": "string",
      "format": "uri"
    },
    "method": {
      "type": "string",
      "const": "POST"
    },
    "input": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "draftId",
    "version",
    "state",
    "tool",
    "price",
    "paidUrl",
    "method",
    "input"
  ],
  "additionalProperties": false
}
