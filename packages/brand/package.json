{
  "name": "@hako/brand",
  "version": "0.0.0",
  "private": true,
  "description": "Hako's name, mark and design tokens: Kawase's Senryo pipeline (tokens.json -> web.css + tokens.ts, contrast check) with Hako's asagi accent.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./assets/*": "./assets/*",
    "./paint.css": "./generated/web.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/check-contrast.mjs",
    "check": "node scripts/check-contrast.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
