{
  "name": "@hako/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Hako's installed UI: shadcn's first-party chat components and primitives (radix-nova), the 21st.dev components plan §6 lists, and the Kawase ui-web ports. Installed code keeps its author's style; colours come from @hako/brand tokens.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/highlighter": "./src/lib/highlighter.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@hako/identity": "workspace:*",
    "@number-flow/react": "catalog:",
    "@shadcn/react": "catalog:",
    "class-variance-authority": "catalog:",
    "cn": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "next-themes": "catalog:",
    "radix-ui": "1.6.7",
    "shiki": "catalog:",
    "sonner": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "4.21.4",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
