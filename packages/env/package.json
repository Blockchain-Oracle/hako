{
  "name": "@hako/env",
  "version": "0.0.0",
  "private": true,
  "description": "Typed environment (zod), parsed lazily per consumer: web server, gateway, CLI. Server-only; `./node` is the gateway's and CLI's entry.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@hako/config": "workspace:*",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
