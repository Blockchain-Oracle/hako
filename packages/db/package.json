{
  "name": "@hako/db",
  "version": "0.0.0",
  "private": true,
  "description": "One Postgres schema (pg, plain SQL migrations): Better Auth, receipts, invoices, contacts, drafts and PayBox links, with typed query helpers per table. Server-only; `./node` is the gateway's and CLI's entry.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./migrate": "./src/migrate.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src scripts",
    "migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@hako/cards": "workspace:*",
    "@hako/defi": "workspace:*",
    "@hako/env": "workspace:*",
    "pg": "catalog:",
    "server-only": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "typescript": "catalog:"
  }
}
