# The web app (apps/web). Copy to .env.local; never commit real values. Only NEXT_PUBLIC_* reach the browser.
# Hako holds no wallet key: paid runs are paid from the user's own PayBox wallet.

NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_DOCS_URL=http://localhost:3200
# The public gateway agents call (free discover/inspect, x402-paid /v2 runs)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server only
HAKO_API_URL=http://localhost:8000
# Chat history and rate limits (optional in development: memory is used without them)
REDIS_URL=
CHAT_REDIS_URL=
# Signs the session cookie
SIWE_SECRET=
IP_HASH_SALT=

# The chat's model: set AI_MODEL ("creator/model") and one key. GROQ_API_KEY alone also works.
AI_MODEL=
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# An OpenAI-compatible custom endpoint: with both set, AI_MODEL is sent to it whole, ahead of the keys above
AI_BASE_URL=
AI_API_KEY=
