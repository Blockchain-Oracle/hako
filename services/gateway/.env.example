# The x402 gateway (services/gateway). Copy to .env.local for `pnpm dev`; never commit real values.

# Where hako-api listens; every read and run is forwarded there (required)
HAKO_API_URL=http://localhost:8000
# The public URL of this gateway, used in the x402 `resource` field
HAKO_PUBLIC_URL=http://localhost:8080
# Comma-separated browser origins allowed to call the gateway, or * for any (empty = *)
HAKO_CORS_ORIGINS=

# The paid route POST /v2/run/<provider>/<slug>: x402 exact in USDC, settled by Coinbase's CDP facilitator.
# Without both CDP keys the gateway mounts no paid route; the free reads and /mcp still work.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# The 0x address that receives every /v2 payment (required with the CDP keys)
HAKO_PAY_TO=
# Empty = Base mainnet (eip155:8453). eip155:84532 is a local-dev override only; the production image refuses it.
X402_MAINNET_NETWORK=
