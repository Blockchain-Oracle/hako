{
  "name": "@hako/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server.mjs --external:@x402/extensions --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "catalog:",
    "@hako/cards": "workspace:*",
    "@hako/config": "workspace:*",
    "@hako/defi": "workspace:*",
    "@hako/env": "workspace:*",
    "@hako/money": "workspace:*",
    "@hako/networks": "workspace:*",
    "@hono/node-server": "catalog:",
    "@lifi/sdk": "catalog:",
    "@lifi/types": "catalog:",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "@x402/hono": "catalog:",
    "hono": "catalog:",
    "ioredis": "catalog:",
    "viem": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
