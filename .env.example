# The tool-router backend (services/api). Copy to .env and fill in what you have; never commit real values.
# A tool whose provider key is missing is listed as unavailable in the catalog, never half-run.
# The gateway's settings (HAKO_API_URL, HAKO_PAY_TO, the CDP keys…) are in services/gateway/.env.example.

HAKO_ENV=development
HAKO_LOG_LEVEL=info
# Cache and health samples. Optional: without it, both live in process memory.
HAKO_REDIS_URL=

# Keyed providers
FIRECRAWL_API_KEY=
GROQ_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
OPENWEATHER_API_KEY=
IPINFO_TOKEN=

# Optional: higher limits on providers that also work without a key
GITHUB_TOKEN=
NASA_API_KEY=
HAKO_OPENALEX_API_KEY=
